# ═════════════════════════════════════════════════════════════════════════════
# OpenLine environment. Copy to .env and fill in — never commit the copy.
# ═════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string.
DATABASE_URL=""

# ── CALL-E (places the phone calls) ──────────────────────────────────────────
# Get a key at https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=""
# Optional: alternative API base URL. Leave unset for production CALL-E.
CALLE_BASE_URL=""

# ── OpenAI (screening questions + resume parsing) ────────────────────────────
OPENAI_API_KEY=""
# Optional: which model to use. Defaults to gpt-4o-mini.
OPENAI_MODEL=""

# ── Cloudflare R2 (stores uploaded resume PDFs) ──────────────────────────────
# The parsed profile is a lossy reading of the resume; the original is kept so
# every parse can be checked against what the candidate actually wrote.
# Without these, resume upload is unavailable; everything else still works.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: public base URL of the bucket, for "view original" links.
R2_PUBLIC_BASE_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Safety controls for real phone calls.
#
# OpenLine runs in dry-run mode unless OPENLINE_LIVE_CALLS is exactly "true".
# In dry run, scripts are generated, guarded, and previewed, but nothing dials.
#
# Live dialing additionally requires the destination number to appear in
# OPENLINE_CALL_ALLOWLIST (comma-separated E.164). An empty allowlist means
# nobody, never everybody — so a deployment cannot telephone a stranger even if
# live mode is switched on by accident.
# ─────────────────────────────────────────────────────────────────────────────
OPENLINE_LIVE_CALLS="false"
OPENLINE_CALL_ALLOWLIST=""

# How the agent sounds. BCP 47 — "en-US" for an American voice, "en-IN" for
# Indian English, "en-GB" for British. This is the only voice control CALL-E's
# Calls API exposes; there is no voice id, gender, or speed. One value is used
# for every call. Defaults to en-US when unset.
OPENLINE_CALL_LOCALE="en-US"

# The one number the demo actually rings. Seeded onto the first candidate, so a
# real line is never committed to source. Must also appear in the allowlist above.
OPENLINE_DEMO_PHONE=""

# Name shown for that one real candidate. Everyone else on the seeded roster
# is fictional.
OPENLINE_DEMO_NAME=""
