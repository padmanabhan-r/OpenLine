# ═════════════════════════════════════════════════════════════════════════════
# OpenLine environment. Copy to .env and fill in — never commit the copy.
# ═════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string.
DATABASE_URL=""

# ── CALL-E (places the phone calls) ──────────────────────────────────────────
# Get a key at https://dashboard.heycall-e.com/account/api-keys
# Calls are LIVE whenever this is set. There is no base-URL override: the key
# only ever goes to https://api.heycall-e.com.
CALLE_API_KEY=""

# Try it without an account: "1" runs the SDK against an in-process fake.
# Every dial completes in seconds with a canned transcript and result; no phone
# rings and the key above, if set, is never used. Same as ./start.sh --fake.
OPENLINE_FAKE_CALLE=""

# Who may press the button. Anyone can READ a deployment; placing a call,
# uploading a resume, or building a script needs this token, entered once at
# /unlock. Required on any public deployment with a live key — without it,
# production refuses to dial at all. Leave empty on a laptop.
OPENLINE_OPERATOR_TOKEN=""

# ── OpenAI (resume parsing) ──────────────────────────────────────────────────
OPENAI_API_KEY=""
# Optional: which model to use. Defaults to gpt-4o-mini.
OPENAI_MODEL=""

# ── Cloudflare R2 (stores uploaded resume PDFs) ──────────────────────────────
# The parsed profile is a lossy reading of the resume; the original is kept so
# every parse can be checked against what the candidate actually wrote.
# Without these, resume upload is unavailable; everything else still works.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: public base URL of the bucket, for "view original" links.
R2_PUBLIC_BASE_URL=""

# ── Call settings ────────────────────────────────────────────────────────────
# Calls are live whenever CALLE_API_KEY is set: a candidate with a number on
# file can be dialed with one click. Every script passes the prohibited-topic
# guard first, and every dial is a human pressing a button that names the person.

# How the agent sounds. BCP 47 — "en-US" for an American voice, "en-IN" for
# Indian English, "en-GB" for British. This is the only voice control CALL-E's
# Calls API exposes; there is no voice id, gender, or speed. The fallback for
# jobs without their own call language (each job picks one). Defaults to en-US.
OPENLINE_CALL_LOCALE="en-US"

# The one number the demo actually rings. Seeded onto the first candidate, so a
# real line is never committed to source.
OPENLINE_DEMO_PHONE=""

# Name shown for that one real candidate. Everyone else on the seeded roster
# is fictional.
OPENLINE_DEMO_NAME=""

# ── Landing page links ───────────────────────────────────────────────────────
# Where "Try the demo" goes (the fake-mode judge instance). Defaults to /jobs.
OPENLINE_DEMO_URL=""
# The demo video. "Watch the video" is hidden until this is set.
OPENLINE_VIDEO_URL=""
